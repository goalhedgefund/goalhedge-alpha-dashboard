PORT=3001
HOST=127.0.0.1

# Fill these in on the deployment machine.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_WS_URL=wss://api-feed.dhan.co
DHAN_REST_URL=https://api.dhan.co
DHAN_AUTH_TYPE=2
DHAN_WS_VERSION=2
DHAN_REQUEST_CODE=15

# Validated live-paper defaults.
SCALPER_ENGINE=1
MULTISCRIPT_AUTO_START=false
MULTISCRIPT_DEFAULT_MODE=LIVE
MULTISCRIPT_MAX_SYMBOLS=50
MULTISCRIPT_DEFAULT_ACTIVE_PER_FRAME=5
MULTISCRIPT_CAPITAL=100000
MULTISCRIPT_RISK_PER_TRADE=0.0015
MULTISCRIPT_KELLY_CAP=0.25
MULTISCRIPT_LIVE_REFRESH_MS=900
MULTISCRIPT_CANDLE_REFRESH_MS=5000

# NIFTY regime refresh defaults. These let refresh-regime.ps1 pull recent 1m
# NIFTY index candles from Dhan and rebuild data/regime/nifty-regime.json.
MULTISCRIPT_REGIME_LOOKBACK_DAYS=30
MULTISCRIPT_NIFTY_SECURITY_ID=13
MULTISCRIPT_NIFTY_EXCHANGE=IDX_I
MULTISCRIPT_NIFTY_INSTRUMENT=INDEX
MULTISCRIPT_DHAN_DELAY_MS=1200
MULTISCRIPT_DHAN_RETRIES=4

# Optional: only needed for REPLAY validation on the deployment machine.
MULTISCRIPT_REPLAY_SOURCE_DIR=
MULTISCRIPT_REPLAY_LOOKBACK_DAYS=7
MULTISCRIPT_REPLAY_SPEED_MULTIPLIER=120
