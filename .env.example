# ─────────────────────────────────────────────────────────────────────
#  CLAUDE Scalping System — Environment Variables
#  
#  HOW TO USE:
#  1. Rename this file from  .env.example  →  .env
#  2. Fill in your Dhan credentials below
#  3. Run:  npm start
#
#  The .env file is listed in .gitignore — it will NEVER be
#  committed or shared. Keep it on your machine only.
# ─────────────────────────────────────────────────────────────────────

# ── Dhan API Credentials ──────────────────────────────────────────────
DHAN_CLIENT_ID=your_client_id_here
DHAN_ACCESS_TOKEN=your_access_token_here

# ── Server config (optional) ──────────────────────────────────────────
PORT=3001

# ─────────────────────────────────────────────────────────────────────
#  WHERE TO FIND YOUR DHAN CREDENTIALS:
#
#  1. Log in at https://dhan.co
#  2. Go to:  My Profile → API Access → Generate Access Token
#  3. Copy Client ID  →  paste next to DHAN_CLIENT_ID=
#  4. Copy Access Token → paste next to DHAN_ACCESS_TOKEN=
#  5. Save the file as  .env  (remove the .example extension)
#
#  NOTE: Dhan access tokens expire daily at midnight.
#        Regenerate and update DHAN_ACCESS_TOKEN each trading day.
# ─────────────────────────────────────────────────────────────────────
